# ---------- shared ----------
COMPOSE_PROJECT_NAME=docvault

# ---------- postgres ----------
POSTGRES_DB=docvault_metadata
POSTGRES_USER=docvault
POSTGRES_PASSWORD=<postgres-password>
POSTGRES_PORT=5432

# ---------- mongo (optional audit) ----------
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=<mongo-root-password>
MONGO_PORT=27017

# ---------- keycloak ----------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<keycloak-admin-password>
KEYCLOAK_PORT=8080

# ---------- minio ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=<minio-root-password>
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=docvault

# ---------- mongo-express ----------
MONGO_EXPRESS_USER=mongoadmin
MONGO_EXPRESS_PASSWORD=<mongo-express-password>
MONGO_EXPRESS_PORT=8081

# ---------- clamav (malware scanning) ----------
CLAMAV_PORT=3310
