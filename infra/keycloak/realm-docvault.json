{
  "realm": "docvault",
  "enabled": true,
  "displayName": "DocVault Realm",
  "loginWithEmailAllowed": false,
  "registrationAllowed": false,

  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "maxFailureWaitSeconds": 900,
  "waitIncrementSeconds": 60,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,

  "passwordPolicy": "length(8) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and notUsername",

  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,

  "roles": {
    "realm": [
      { "name": "viewer" },
      { "name": "editor" },
      { "name": "approver" },
      { "name": "co" },
      { "name": "compliance_officer" },
      { "name": "admin" }
    ]
  },

  "groups": [
    {
      "name": "finance-team",
      "path": "/finance-team"
    }
  ],

  "requiredActions": [
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 30,
      "config": {}
    },
    {
      "alias": "UPDATE_PROFILE",
      "name": "Update Profile",
      "providerId": "UPDATE_PROFILE",
      "enabled": true,
      "defaultAction": false,
      "priority": 40,
      "config": {}
    },
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 50,
      "config": {}
    },
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 60,
      "config": {}
    }
  ],

  "clients": [
    {
      "clientId": "docvault-gateway",
      "name": "DocVault Gateway API",
      "enabled": true,
      "protocol": "openid-connect",

      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-gateway-secret",

      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,

      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:3006/*",
        "http://localhost:3006/api/auth/callback",
        "https://app.docvault.id.vn/*",
        "https://app.docvault.id.vn/api/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:3006",
        "https://app.docvault.id.vn"
      ],

      "attributes": {
        "access.token.lifespan": "900",
        "post.logout.redirect.uris": "+"
      },
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],

  "users": [
    {
      "username": "viewer1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Viewer",
      "lastName": "One",
      "email": "viewer1@docvault.local",
      "requiredActions": [],
      "credentials": [{ "type": "password", "value": "Passw0rd!", "temporary": false }],
      "realmRoles": ["viewer"]
    },
    {
      "username": "editor1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Editor",
      "lastName": "One",
      "email": "editor1@docvault.local",
      "requiredActions": [],
      "groups": ["/finance-team"],
      "credentials": [{ "type": "password", "value": "Passw0rd!", "temporary": false }],
      "realmRoles": ["editor"]
    },
    {
      "username": "approver1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Approver",
      "lastName": "One",
      "email": "approver1@docvault.local",
      "requiredActions": [],
      "credentials": [{ "type": "password", "value": "Passw0rd!", "temporary": false }],
      "realmRoles": ["approver"]
    },
    {
      "username": "co1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "CO",
      "lastName": "One",
      "email": "co1@docvault.local",
      "requiredActions": ["CONFIGURE_TOTP"],
      "credentials": [{ "type": "password", "value": "Passw0rd!", "temporary": false }],
      "realmRoles": ["co", "compliance_officer"]
    },
    {
      "username": "admin1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "One",
      "email": "admin1@docvault.local",
      "requiredActions": ["CONFIGURE_TOTP"],
      "credentials": [{ "type": "password", "value": "Passw0rd!", "temporary": false }],
      "realmRoles": ["admin"]
    },
    {
      "username": "co-mfa-demo",
      "enabled": true,
      "emailVerified": true,
      "firstName": "CO MFA",
      "lastName": "Demo",
      "email": "co-mfa-demo@docvault.local",
      "requiredActions": ["CONFIGURE_TOTP"],
      "credentials": [{ "type": "password", "value": "Passw0rd!", "temporary": false }],
      "realmRoles": ["co", "compliance_officer"]
    },
    {
      "username": "admin-mfa-demo",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin MFA",
      "lastName": "Demo",
      "email": "admin-mfa-demo@docvault.local",
      "requiredActions": ["CONFIGURE_TOTP"],
      "credentials": [{ "type": "password", "value": "Passw0rd!", "temporary": false }],
      "realmRoles": ["admin"]
    }
  ]
}
