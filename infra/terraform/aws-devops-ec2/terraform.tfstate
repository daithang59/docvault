  "outputs": {
    "bootstrap_log_command": {
      "value": "ssh ubuntu@54.169.229.80 'sudo tail -n 200 /var/log/docvault-devops-bootstrap.log'",
      "type": "string"
    },
    "compose_ps_command": {
      "value": "ssh ubuntu@54.169.229.80 'cd /opt/docvault \u0026\u0026 docker compose -f docker-compose.devops.yml ps'",
      "type": "string"
    },
    "ec2_public_ip": {
      "value": "54.169.229.80",
      "type": "string"
    },
    "jenkins_initial_password_command": {
      "value": "ssh ubuntu@54.169.229.80 'sudo docker exec docvault-jenkins cat /var/jenkins_home/secrets/initialAdminPassword'",
      "type": "string"
    },
    "jenkins_url": {
      "value": "http://54.169.229.80:8080",
      "type": "string"
    },
    "sonarqube_url": {
      "value": "http://54.169.229.80:9000",
      "type": "string"
