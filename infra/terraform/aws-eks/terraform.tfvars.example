aws_region      = "ap-southeast-1"
cluster_name    = "docvault-eks"
cluster_version = "1.35"
environment     = "testing"

# For a stricter setup, replace this with your workstation public IP CIDR,
# for example ["203.0.113.10/32"].
cluster_endpoint_public_access_cidrs = ["0.0.0.0/0"]

# CIDRs allowed to reach NodePort services for web and Keycloak.
# For a stricter setup, replace this with your workstation public IP CIDR.
nodeport_access_cidrs = ["0.0.0.0/0"]

node_instance_types = ["t3.large"]
node_desired_size   = 2
node_min_size       = 1
node_max_size       = 3
node_disk_size      = 30

# false = lower-cost MVP, nodes in public subnets.
# true = better practice, nodes in private subnets with NAT Gateway cost.
enable_nat_gateway = false

# Optional: manage Jenkins IAM Roles Anywhere resources with Terraform.
# The path must point to the public CA certificate, not docvault-ca.key.
# enable_jenkins_roles_anywhere              = true
# jenkins_rolesanywhere_ca_certificate_path  = "C:/Users/<user>/rolesanywhere-certs/docvault-ca.pem"
# jenkins_rolesanywhere_certificate_common_name = "jenkins-controller"
# jenkins_rolesanywhere_trust_anchor_name = "docvault-jenkins-local-ca"
# jenkins_rolesanywhere_profile_name      = "docvault-jenkins-profile"
# jenkins_rolesanywhere_role_name         = "docvault-jenkins-secretsmanager-read"
# jenkins_secretsmanager_secret_names = [
#   "harbor-docvault-dev-robot-token",
# ]
