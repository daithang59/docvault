PORT=3002
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=docvault
KEYCLOAK_AUDIENCE=docvault-gateway

METADATA_SERVICE_URL=http://localhost:3001
AUDIT_SERVICE_URL=http://localhost:3004
AUDIT_INGEST_TOKEN=replace-with-strong-internal-audit-ingest-token

# Legacy single-key dev mode. If incoming grant tokens include kid, document-
# service accepts only GRANT_TOKEN_CURRENT_KID and GRANT_TOKEN_PREVIOUS_KID.
DOWNLOAD_GRANT_SECRET=replace-with-strong-download-grant-secret
PREVIEW_GRANT_SECRET=replace-with-strong-preview-grant-secret
GRANT_TOKEN_CURRENT_KID=2026_05
GRANT_TOKEN_PREVIOUS_KID=2026_04
DOWNLOAD_GRANT_SECRET_2026_05=replace-with-current-download-grant-secret
DOWNLOAD_GRANT_SECRET_2026_04=replace-with-previous-download-grant-secret
PREVIEW_GRANT_SECRET_2026_05=replace-with-current-preview-grant-secret
PREVIEW_GRANT_SECRET_2026_04=replace-with-previous-preview-grant-secret

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpw
S3_BUCKET=docvault
S3_FORCE_PATH_STYLE=true
# Public URL for presigned URLs — replace <YOUR_LAN_IP> with your machine's LAN IP
# e.g. S3_PUBLIC_URL=http://192.168.1.100:9000
S3_PUBLIC_URL=http://localhost:9000

# Malware scanning:
# - local-eicar keeps deterministic local tests and demo behavior.
# - clamav uses a clamd TCP daemon when configured.
MALWARE_SCANNER_MODE=local-eicar
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=5000
# Default fail-closed blocks uploads when ClamAV is unavailable.
# Use fail-open only for local development demos where availability matters more.
MALWARE_SCANNER_FAILURE_POLICY=fail-closed
