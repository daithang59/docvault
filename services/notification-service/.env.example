PORT=3005
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_ISSUER=http://localhost:8080/realms/docvault
KEYCLOAK_REALM=docvault
KEYCLOAK_AUDIENCE=docvault-gateway

# MongoDB connection — notifications are now persisted (survive restarts).
MONGODB_URI="<mongodb-notification-connection-url>"

# Email delivery (cloud provider — Resend). Leave EMAIL_API_KEY unset to disable
# email entirely (in-app notifications still work). Sub→email is resolved via the
# Keycloak Admin API using client credentials below.
EMAIL_API_KEY=
EMAIL_FROM="DocVault <noreply@docvault.local>"
# Comma-separated NotifyTypes that also trigger email. Defaults to REJECTED.
EMAIL_NOTIFY_TYPES=REJECTED
# Keycloak client-credentials for resolving recipient emails (Admin API).
KEYCLOAK_CLIENT_ID=docvault-gateway
KEYCLOAK_CLIENT_SECRET=dev-gateway-secret
