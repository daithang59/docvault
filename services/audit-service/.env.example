PORT=3004
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_ISSUER=http://localhost:8080/realms/docvault
KEYCLOAK_REALM=docvault
KEYCLOAK_AUDIENCE=docvault-gateway
AUDIT_INGEST_TOKEN=replace-with-strong-internal-audit-ingest-token
# Optional: during rotation, set the old token here so callers still using it
# are accepted until they switch to AUDIT_INGEST_TOKEN. Remove once rotation completes.
AUDIT_INGEST_TOKEN_PREVIOUS=

# Audit event signing (tamper-evidence). When set, each new audit event is
# signed with HMAC-SHA256 over its hash, so the chain cannot be silently
# recomputed by anyone with raw DB write access. Leave empty to disable
# (events remain hash-chained but unsigned). For rotation, set AUDIT_SIGNING_KID
# and provide AUDIT_SIGNING_SECRET_<kid> values.
AUDIT_SIGNING_SECRET=
AUDIT_SIGNING_KID=

MONGODB_URI="<mongodb-connection-url>"
