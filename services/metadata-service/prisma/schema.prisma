generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum DocumentStatus {
  DRAFT
  PENDING
  PUBLISHED
  ARCHIVED
  DELETED
}

enum ClassificationLevel {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  SECRET
}

enum AclSubjectType {
  USER
  ROLE
  GROUP
  ALL
}

enum DocumentPermission {
  READ
  DOWNLOAD
  WRITE
  APPROVE
}

enum AclEffect {
  ALLOW
  DENY
}

enum WorkflowAction {
  SUBMIT
  APPROVE
  REJECT
  ARCHIVE
  DELETE
  RETENTION
}

enum DocumentSharePermission {
  VIEW
  DOWNLOAD
}

enum DocumentSavedViewScope {
  PRIVATE
  TEAM
}

enum OrganizationRole {
  MEMBER
  ADMIN
}

model Organization {
  id          String                   @id @default(uuid())
  name        String
  slug        String                   @unique
  ownerId     String
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  memberships OrganizationMembership[]

  @@index([ownerId])
  @@map("organizations")
}

model OrganizationMembership {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

model Document {
  id              String            @id @default(uuid())
  organizationId  String
  title           String
  description     String?
  ownerId         String
  classification  ClassificationLevel @default(INTERNAL)
  dlpStatus       String            @default("NOT_SCANNED")
  dlpFindings     Json?
  dlpDetectedAt   DateTime?
  retentionClass  String?
  retentionUntil  DateTime?
  retentionReason String?
  legalHold       Boolean           @default(false)
  legalHoldReason String?
  legalHoldBy     String?
  legalHoldAt     DateTime?
  approvalChain   String[]          @default([])
  approvalStep    Int               @default(0)
  tags            String[]          @default([])
  status          DocumentStatus    @default(DRAFT)
  currentVersion  Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  publishedAt     DateTime?
  archivedAt      DateTime?
  deletedAt       DateTime?
  versions        DocumentVersion[]
  aclEntries      DocumentAcl[]
  workflowHistory DocumentWorkflowHistory[]
  comments        DocumentComment[]
  shareLinks      DocumentShareLink[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([ownerId])
  @@index([status])
  @@index([retentionUntil])
  @@index([status, retentionUntil])
  @@index([legalHold])
  @@index([tags], type: Gin)
  @@map("documents")
}

model DocumentVersion {
  id          String   @id @default(uuid())
  docId       String
  version     Int
  objectKey   String
  checksum    String
  size        Int
  filename    String
  contentType String?
  dlpStatus   String   @default("NOT_SCANNED")
  dlpFindings Json?
  createdAt   DateTime @default(now())
  createdBy   String
  document    Document @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@unique([docId, version])
  @@index([docId, createdAt])
  @@map("document_versions")
}

model DocumentAcl {
  id          String             @id @default(uuid())
  docId       String
  subjectType AclSubjectType
  subjectId   String?
  permission  DocumentPermission
  effect      AclEffect
  createdAt   DateTime           @default(now())
  document    Document           @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId, permission])
  @@index([subjectType, subjectId])
  @@map("document_acl")
}

model DocumentWorkflowHistory {
  id         String         @id @default(uuid())
  docId      String
  fromStatus DocumentStatus
  toStatus   DocumentStatus
  action     WorkflowAction
  actorId    String
  reason     String?
  createdAt  DateTime       @default(now())
  document   Document       @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId, createdAt])
  @@map("document_workflow_history")
}

model DocumentComment {
  id          String   @id @default(uuid())
  docId       String
  authorId    String
  authorRoles String[]
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  document    Document @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId, createdAt])
  @@map("document_comments")
}

model DocumentSavedView {
  id          String                 @id @default(uuid())
  organizationId String
  name        String
  description String?
  filters     Json
  scope       DocumentSavedViewScope @default(PRIVATE)
  ownerId     String
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([organizationId, scope])
  @@index([ownerId, scope])
  @@index([scope, createdAt])
  @@map("document_saved_views")
}

model DocumentShareLink {
  id            String                 @id @default(uuid())
  docId         String
  tokenHash     String                 @unique
  permission    DocumentSharePermission @default(VIEW)
  createdBy     String
  expiresAt     DateTime
  maxAccessCount Int?
  accessCount   Int                    @default(0)
  lastAccessedAt DateTime?
  revokedAt     DateTime?
  revokedBy     String?
  createdAt     DateTime               @default(now())
  document      Document               @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId, createdAt])
  @@index([expiresAt])
  @@map("document_share_links")
}
